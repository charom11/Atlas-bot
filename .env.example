# ==============================================================================
# ATLAS BOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and insert your real production API keys.
# NEVER commit your actual .env file with secrets into version control!

# ------------------------------------------------------------------------------
# 1. Binance Futures API Credentials
# Required for live trading and account data access.
# Make sure "Enable Futures" permission is granted on Binance API management.
# ------------------------------------------------------------------------------
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ------------------------------------------------------------------------------
# 2. Telegram C2 & Notifications
# Used for real-time trade signals, circuit breaker alerts, and remote C2 controls.
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_NOTIFICATIONS=true
